{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "paths": {
      "@demo/shared": [
        "./shared/src/index.ts"
      ],
      "@demo/shared/*": [
        "./shared/src/*"
      ]
    }
  }
}
